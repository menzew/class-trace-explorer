{
  "name": "class-trace-explorer",
  "version": "2.0.0",
  "description": "Visualize JVM class-resolution traces as an interactive React Flow graph.",
  "license": "BSD-3-Clause",
  "author": "ClassTrace Explorer contributors",
  "homepage": "https://github.com/menzew/class-trace-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menzew/class-trace-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/menzew/class-trace-explorer/issues"
  },
  "keywords": [
    "java",
    "jvm",
    "class-loading",
    "visualization",
    "react-flow"
  ],
  "type": "module",
  "bin": {
    "clgrapher": "dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    },
    "bundle-require": {
      "esbuild": "^0.28.1"
    }
  },
  "scripts": {
    "build:web": "vite build",
    "build:cli": "tsup",
    "build": "npm run build:web && npm run build:cli",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/dagre": "^0.7.52",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^19.2.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@xyflow/react": "^12.3.0",
    "eslint": "^9.9.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.0.1",
    "vitest": "^3.2.7"
  }
}
